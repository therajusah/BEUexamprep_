# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/beuexamprep"

# JWT Secret Key for Authentication
# Generate a secure random string for production
JWT_SECRET="your-secure-jwt-secret-key-here"

# Admin Secret Code for Creating Admin Accounts
# Change this to a secure code known only to authorized admins
# Default: BEU2024ADMIN
ADMIN_SECRET_CODE="BEU2024ADMIN"

# Cloudinary Configuration for File Uploads
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Node Environment
NODE_ENV="development"
